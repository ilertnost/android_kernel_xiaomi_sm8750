Pin the SukiSU version string on the main branch

Upstream leaves the full version as unknown@unknown whenever git cannot
answer, which it always cannot inside the bazel sandbox. Pin the SHA we
actually build so the manager and any log show what is running.

On main this lives in kernel/Kbuild, not kernel/Makefile, which is why the
existing apex fix does not reach here.

diff --git a/kernel/Kbuild b/kernel/Kbuild
--- a/kernel/Kbuild
+++ b/kernel/Kbuild
@@ -126,7 +126,8 @@ GITHUB_COMMITS   := $(shell $(CURL_BIN) -sI "$(GITHUB_API_BASE)/commits?sha=$(REPO_BRANCH)&per_page=1" 2>/dev/null | grep -i "link:" | sed -n 's/.*page=\([0-9]*\)>; rel="last".*/\1/p')
 LOCAL_COUNT     := $(if $(GITHUB_COMMITS),$(GITHUB_COMMITS),$(git_commit_count))
 KSU_VERSION     := $(if $(LOCAL_COUNT),$(shell expr $(VERSION_BASE) + $(LOCAL_COUNT) - $(VERSION_OFFSET)),13000)
 VERSION_TAG     := $(or $(KSU_GITHUB_VER),$(git_latest_tag),4.2.0)
-KSU_VERSION_FULL := $(if $(call git_short_sha),v$(VERSION_TAG)-$(call git_short_sha)@$(call git_branch),v$(VERSION_TAG)-$(REPO_NAME)-unknown@unknown)
+KSU_PINNED_SHA ?= 42d7fda3
+KSU_VERSION_FULL := $(if $(call git_short_sha),v$(VERSION_TAG)-$(KSU_PINNED_SHA)@apexfoundry,v$(VERSION_TAG)-$(REPO_NAME)-$(KSU_PINNED_SHA)@apexfoundry)
 $(info -- $(REPO_NAME) version: $(KSU_VERSION) [$(KSU_VERSION_FULL)])

 ccflags-y += -DKSU_VERSION=$(KSU_VERSION)

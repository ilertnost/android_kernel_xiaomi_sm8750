index ef582840f..f6d301106 100644
--- a/kernel/module/Kconfig
+++ b/kernel/module/Kconfig
@@ -242,6 +242,33 @@ config MODULE_SIG_PROTECT
 	    exported by the Android GKI modules. Loading will fail and return
 	    -EACCES (Permission denied) if symbol access conditions are not met.
 
+config APEX_RELAX_GKI_MODULE_KMI
+	bool "Relax GKI symbol protection for unsigned modules"
+	depends on MODULE_SIG_PROTECT
+	help
+	  Let modules that are not signed with the GKI key import any exported
+	  symbol, not only the ones on the generated unprotected list.
+
+	  With this off, kernel/module/main.c refuses such a module with -EACCES,
+	  which modprobe reports as "Permission denied". The reason is printed by
+	  the kernel as "Protected symbol: <name>".
+
+	  Why this exists. The stock modules on the device are built for 6.6.118.
+	  Our kernel is AOSP GKI 6.6.139, and the 6.6.139 KMI list no longer
+	  contains every symbol those modules import, so ten of them are refused:
+	  bluetooth, hci_uart, btbcm, btqca, btsdio, hidp, rfcomm, rtl8150 and
+	  9pnet_fd. The KMI lists are stock AOSP, untouched, so this is a
+	  consequence of the version gap rather than anything done here.
+
+	  If this is off, every clean AOSP 6.6.139 build behaves the same way on
+	  this device.
+
+	  Trade-off. Unsigned modules are no longer confined to a vetted symbol
+	  set. On a kernel that already grants root through SukiSU that boundary
+	  protects little, but it is not nothing. Enabling this can also load a
+	  second Bluetooth stack on top of the working vendor one, which may break
+	  Bluetooth rather than fix it. Test it, do not assume it.
+
 config MODULE_SIG_ALL
 	bool "Automatically sign all modules"
 	default y

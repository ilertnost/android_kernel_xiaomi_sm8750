+{
+	char *scon = NULL, *tcon = NULL;
+	u32 ssid, tsid;
+	u16 tclass;
+	struct av_decision avd;
+	ssize_t length;
+
+	// apply to all app uids
+	if (likely(current_uid().val < 10000 || !ksu_selinux_hide_running))
+		return sel_write_access(file, buf, size);
